<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Warm the model into memory at login.

  Without this, the first correction of the day costs 15-50s while Ollama loads
  qwen3:4b from disk; afterwards it is ~1s. corrector.py asks for keep_alive of 8h,
  so one warm-up covers a working day.

  num_ctx must match corrector.py. Ollama keys its loaded-model cache on these
  options, so a mismatch loads the model a second time and wastes the warm-up -
  and a default context would reserve 42GB and spill onto the CPU.

  Install:
    cp com.saaf.preload.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.saaf.preload.plist
  Remove:
    launchctl unload -w ~/Library/LaunchAgents/com.saaf.preload.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.saaf.preload</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/curl</string>
        <string>--silent</string>
        <string>--show-error</string>
        <string>--max-time</string>
        <string>180</string>
        <string>http://localhost:11434/api/generate</string>
        <string>-d</string>
        <string>{"model":"qwen3:4b","prompt":"hi","stream":false,"think":false,"keep_alive":"8h","options":{"num_predict":1,"num_ctx":2048}}</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Re-warm every 7 hours.
         This must stay BELOW the keep_alive above (8h), or the model unloads and
         nothing loads it again until the next login. It was 86400 (once a day),
         which meant an evening correction after a morning login paid the full
         15-50s cold load - and `launchctl list` showed exit status 7 (curl
         "failed to connect"), because the one attempt at login fired before
         Ollama was listening and there was no second attempt for 24 hours.
         7 hours covers both problems: it renews before the TTL expires, and a
         failed attempt is retried the same working day. -->
    <key>StartInterval</key>
    <integer>25200</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/saaf-preload.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/saaf-preload.log</string>
</dict>
</plist>
